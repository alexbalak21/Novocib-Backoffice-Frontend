---
import { client } from '../lib/graphqlClient';
import { GET_ITEMS } from '../lib/queries/items';
import type { ItemsQueryResult } from '../types/items';
import ItemsTable from '../components/IItemsTable.astro';
import ItemForm from '../components/ItemForm.astro';

export const prerender = false;

const { items } = await client.request<ItemsQueryResult>(GET_ITEMS);
const editingId = Astro.url.searchParams.get('edit');

const editingItem = editingId
	? items.find((item) => String(item.id) === String(editingId)) ?? null
	: null;

const visibleItems = editingItem
	? items.filter((item) => String(item.id) !== String(editingItem.id))
	: items;

console.log("Items from GraphQL:", items);
---

<h1 class="text-2xl font-bold mb-4">Items</h1>

{editingItem ? (
	<ItemForm
		item={editingItem}
		action={`/items/${editingItem.id}/update`}
		submitLabel="Update"
		cancelHref="/items"
	/>
) : (
	<ItemForm action="/items/create" submitLabel="Create" />
)}

<ItemsTable items={visibleItems} />
