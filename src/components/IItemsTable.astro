---
import type { Item } from "../types/items";

export interface Props {
  items: Item[];
}

const { items } = Astro.props;
---


<table class="w-full border-collapse text-left">
  <thead>
    <tr class="border-b">
      <th class="w-16 p-2 font-semibold">ID</th>
      <th class="w-48 p-2 font-semibold">Title</th>
      <th class="p-2 font-semibold">Description</th>
      <th class="w-32 p-2 font-semibold">Actions</th>
    </tr>
  </thead>

  <tbody>
    {items.map((item) => (
      <tr class="border-b hover:bg-gray-50">
        <td class="p-2">{item.id}</td>
        <td class="p-2">{item.name}</td>
        <td class="p-2">{item.description}</td>
        <td class="p-2 flex gap-2">
          <a
            href={`/items/${item.id}/edit`}
            class="px-2 py-1 bg-blue-600 text-white rounded text-sm"
          >
            Edit
          </a>

          <form method="POST" action={`/items/${item.id}/delete`}>
            <button
              type="submit"
              class="px-2 py-1 bg-red-600 text-white rounded text-sm"
            >
              Delete
            </button>
          </form>
        </td>
      </tr>
    ))}
  </tbody>
</table>
